# ---- Notion (required) ----
# Create an internal integration at https://www.notion.so/my-integrations,
# share the blog database with it, then paste the secret here.
# IMPORTANT: this is server-only. Never prefix it with NEXT_PUBLIC_.
NOTION_TOKEN=secret_xxx

# The blog database id (from the database URL, the 32-char id before "?v=").
NOTION_DATABASE_ID=2f7009062c378165bd1dc6120f6a2b44

# ---- Site (required) ----
# Canonical absolute URL, no trailing slash. Used for SEO/sitemap/RSS.
SITE_URL=https://shenzhe.org

# ---- Comments: Giscus (optional) ----
# From https://giscus.app — leave blank to disable comments.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
