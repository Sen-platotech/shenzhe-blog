{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shenzhe-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "stats.shenzhe.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shenzhe-stats",
      "database_id": "cf52ac23-eaee-4895-9e27-cd9340f222bd",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://shenzhe.org",
    "RETENTION_DAYS": "30"
  },
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
