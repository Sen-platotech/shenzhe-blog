{
  "name": "shenzhe-stats-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types worker-configuration.d.ts",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev --local"
  },
  "devDependencies": {
    "esbuild": "^0.25.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  }
}
